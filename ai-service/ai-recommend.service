[Unit]
Description=M2 AI Recommendation Wrapper (FastAPI)
After=network.target

[Service]
Type=simple
# Adjust User/Group to match the OS user that owns /opt/ai-service and
# /opt/v1-motion-standard-curves (the user that ran `git clone` in the
# deploy guide). On a default Ubuntu cloud image, that's usually `ubuntu`.
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-service
Environment="BORGES_ROOT=/opt/v1-motion-standard-curves-main"
# PYTHON_BIN omitted — ai_service defaults to sys.executable (same venv as uvicorn below)
Environment="MEASUREMENTS_BASE_URL=http://113.44.220.94:3000/measurements"
Environment="SCRIPT_TIMEOUT_SEC=90"
ExecStart=/opt/ai-service/.venv/bin/uvicorn ai_service:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
